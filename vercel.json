{
  "installCommand": "npm ci && npm ci --prefix frontend --include=dev",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/en",
      "destination": "https://incometax.nl/?lang=en",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "https://incometax.nl/?lang=en",
      "permanent": true
    },
    {
      "source": "/nl",
      "destination": "https://incometax.nl/?lang=nl",
      "permanent": true
    },
    {
      "source": "/nl/",
      "destination": "https://incometax.nl/?lang=nl",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.incometax.nl"
        }
      ],
      "destination": "https://incometax.nl/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "framework": null
}
